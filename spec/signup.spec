Feature "新規登録" do
  Scenario "新規登録ページの表示" do
    Given None do
      When "新規登録ページにアクセスすると、" do
        Then "ユーザー名入力欄が表示される"
          .And "メールアドレス入力欄が表示される"
          .And "パスワード入力欄とパスワード（確認）入力欄が表示される"
          .And "新規登録ボタンが表示される"
          .And "ログインへのリンクが表示される"
      end
    end
  end

  Scenario "正常な新規登録" do
    Given None do
      When "すべての項目を正しく入力して新規登録すると、" do
        Then "アカウントが作成される"
          .And "入力したメールアドレス宛に確認メールが送信される"
          .And "確認メールを送信した旨の画面が表示される"
      end
    end
  end

  Scenario "既に登録されているメールアドレス" do
    # メールアドレスの登録有無が画面から分からないよう、通常の登録と同じ画面を表示する
    Given "認証済みのアカウントで使われているメールアドレスのとき" do
      When "そのメールアドレスで新規登録すると、" do
        Then "確認メールを送信した旨の画面が表示される"
          .And "そのメールアドレス宛に、登録済みである旨とパスワード再設定の案内が送信される"
      end
    end

    Given "未認証のアカウントで使われているメールアドレスのとき" do
      When "そのメールアドレスで新規登録すると、" do
        # 新しい入力内容はメール認証の完了時に反映される
        Then "確認メールを送信した旨の画面が表示される"
          .And "今回の入力内容で確認メールが再送される"
      end
    end
  end

  Scenario "入力内容の誤り" do
    Given None do
      When "未入力の項目がある状態で新規登録しようとすると、" do
        Then "入力を促すエラーメッセージが表示される"
          .And "登録されない"
      end

      When "パスワードが最低文字数に満たない状態で新規登録しようとすると、" do
        Then "最低文字数を示すエラーメッセージが表示される"
          .And "登録されない"
      end

      When "パスワードと確認用パスワードが一致しない状態で新規登録しようとすると、" do
        Then "パスワードが一致しない旨のエラーメッセージが表示される"
          .And "登録されない"
      end

      When "既に使用されているユーザー名で新規登録しようとすると、" do
        Then "ユーザー名が既に使用されている旨のエラーメッセージが表示される"
          .And "登録されない"
      end
    end
  end

  Scenario "ログインへのリンク" do
    Given None do
      When "ログインへのリンクをクリックすると、" do
        Then "ログインページに遷移する"
      end
    end
  end
end
