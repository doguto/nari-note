Feature "マイ定跡" do
  # 盤で指して自分の定跡を作り、研究盤で局面を行き来する。
  # 指した局面はすべて保存され、1 手ごとの遷移でつながる。開始局面・分岐点・合流点と、ユーザーがノードにした局面がノード（グラフの点）になり、
  # ノードから次のノードまでの遷移の並びが辺になる
  Scenario "定跡の一覧と作成" do
    Given "ログインしているとき" do
      When "マイ定跡のページを開くと、" do
        Then "自分の定跡が更新日の新しい順に表示される"
          .And "他人の定跡は表示されない"
      end

      When "定跡の名前を入力して作成すると、" do
        Then "平手の初期局面から始まる定跡が作成される"
          .And "その定跡の研究盤に遷移する"
      end

      When "盤面エディタで開始局面を編集してから作成すると、" do
        Then "編集した局面から始まる定跡が作成される"
      end

      When "手番でない側の玉に王手がかかっている局面から作成しようとすると、" do
        Then "エラーメッセージが表示される"
          .And "定跡は作成されない"
      end

      When "定跡を削除すると、" do
        Then "確認ダイアログが表示され、確定すると局面・手順・研究メモがすべて削除される"
      end
    end

    Given "未ログイン状態のとき" do
      When "マイ定跡のページや研究盤にアクセスすると、" do
        Then "ログインページにリダイレクトされる"
      end
    end
  end

  Scenario "研究盤で指す・保存する" do
    Given "自分の定跡の研究盤を開いたとき" do
      When None do
        Then "開始局面が表示される"
      end
    end

    Given "自分の定跡の研究盤を開いているとき" do
      When "盤で駒を動かすと、" do
        Then "合法手だけを指せる"
          .And "まだ定跡に無い手は保存していない手として手元にだけ置かれる"
          .And "保存していない手が残っている間にページを離れようとすると警告が出る"
      end

      When "保存を押すと、" do
        Then "保存していない手がすべて定跡に入る"
          .And "既存の辺の途中から分かれた手は、分かれた局面がノードになって辺が分かれる"
          .And "手順前後で同じ局面に着いた手は、1 つのノードに合流する"
      end

      When "破棄を押すと、" do
        Then "保存していない手が消える"
      end

      When "← → キーを押すと、" do
        Then "保存済みの手も保存していない手も、1 手ずつ戻る・進む"
      end

      When "↑ ↓ キーを押すと、" do
        Then "「ここからの手」で進む手を選べる"
      end
    end
  end

  Scenario "ここからの手" do
    Given "ノードの局面を表示しているとき" do
      When None do
        Then "そのノードから出る辺の手と、保存していない手が一覧で表示される"
          .And "AI候補手の評価値があれば手の横に表示される"
      end

      When "辺を削除すると、" do
        Then "確認の後、その辺と、その先にしか無いノード・辺が消える"
      end

      When "辺に条件を入力すると、" do
        Then "その辺に条件が付き、グラフの辺にも表示される"
          .And "まとめた局面どうしの違いから作った条件の候補を選んで入力できる"
      end
    end

    Given "ノードでない辺の途中の局面を表示しているとき" do
      When None do
        Then "保存済みの手は表示されず、保存していない手だけが表示される"
      end
    end
  end

  Scenario "ノード" do
    Given "ノードでない辺の途中の局面を表示しているとき" do
      When "ノードにするを押すか、形の名前を入力すると、" do
        Then "その局面がノードになり、辺がその局面で 2 本に分かれる"
          .And "元の辺の条件は、出発側の辺に残る"
      end

      When "この辺を削除すると、" do
        Then "確認の後、その局面を通る辺と、その先にしか無いノード・辺が消える"
      end
    end

    Given "ノードの局面を表示しているとき" do
      When "形の名前か研究メモを入力すると、" do
        Then "名前と研究メモが保存される"
          .And "盤面から作った名前の候補（戦型・囲い・端歩など）を選んで入力できる"
      end

      When "ノードの名前と研究メモを両方空にすると、" do
        Then "分岐点・合流点・まとめたノードでなければ、ノードが解除され手順の途中に戻る"
      end

      When "ノードを解除すると、" do
        Then "局面が手順の途中に戻り、前後の辺が 1 本につながる"
          .And "分岐点・合流点・開始局面のノードは解除できない"
      end

      When "ノードを削除すると、" do
        Then "確認の後、そのノードに入る辺・出る辺と、その先にしか無いノード・辺が消える"
          .And "開始局面のノードは削除できない"
      end
    end

    Given "保存していない局面を表示しているとき" do
      When None do
        Then "名前は付けられず、保存すると名前を付けられる旨が表示される"
      end
    end
  end

  Scenario "似ている局面をまとめる" do
    # 似ているかどうかは駒割と駒の配置の違いだけで判定する。しきい値の正は ShogiSimilarity
    Given "ノードの局面を表示しているとき" do
      When None do
        Then "盤面の違いが少ない他のノードが、違いの説明とともに「似ている局面」として表示される"
      end

      When "似ている局面の「まとめる」を押すと、" do
        Then "2 つのノードが 1 つになり、名前と研究メモを共有する"
          .And "グラフでは 1 つのノードとして描かれ、まとめた局面の数が表示される"
      end
    end

    Given "複数の局面をまとめたノードの局面を表示しているとき" do
      When None do
        Then "まとめた局面の一覧が、表示中の局面との違いとともに表示される"
      end

      When "局面を「分ける」と、" do
        Then "その局面はまとめたノードから外れ、別のノードになる"
      end
    end
  end

  Scenario "定跡グラフ" do
    Given "研究盤を開いているとき" do
      When None do
        Then "ノードが点として描かれる。名前の無いノードは「名前なし」、開始局面は「開始」と表示される"
          .And "辺は、ノードを出る手と入る手を並べて描かれ、途中の手は省略される"
          .And "ノードにたどり着かない辺は、省略記号で止めて描かれる"
          .And "まとめた局面から同じ手で別のノードへ分かれる辺は、条件付きとして描き分けられる"
      end

      When "ノードや辺の手を押すと、" do
        Then "その局面へ盤が移る"
      end
    end
  end

  Scenario "AI候補手" do
    Given "将棋エンジンが使える環境で局面を表示しているとき" do
      When None do
        Then "その局面の候補手と評価値が、読み筋とともに表示される"
          .And "保存していない局面でも解析できる"
      end

      When "エンジンを切り替えると、" do
        Then "選んだエンジンで解析し直し、次に開いたときも同じエンジンが選ばれている"
      end

      When "候補手を押すと、" do
        Then "その手を盤で指す"
      end
    end
  end

  Scenario "権限" do
    Given "他人の定跡の研究盤にアクセスしたとき" do
      When None do
        Then "定跡を見ることも変更することもできない"
      end
    end
  end
end
