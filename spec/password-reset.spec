Feature "パスワード再設定" do
  Scenario "再設定メールの送信" do
    Given None do
      When "パスワード再設定ページでメールアドレスを入力して送信すると、" do
        # メールアドレスの登録有無が画面から分からないよう、未登録でも同じ画面を表示する
        Then "メールを送信した旨の画面が表示される"
          .And "登録済みのメールアドレスであれば、再設定用リンクを記載したメールが送信される"
      end

      When "メールアドレスを入力せずに送信しようとすると、" do
        Then "入力を促すエラーメッセージが表示される"
      end
    end

    Given "直前に再設定メールを送信しているとき" do
      When "同じメールアドレスで再度送信すると、" do
        Then "メールを送信した旨の画面が表示される"
          .And "メールは再送されない"
      end
    end
  end

  Scenario "新しいパスワードの設定" do
    Given "再設定用リンクを開いたとき" do
      When "新しいパスワードと確認用パスワードを入力して送信すると、" do
        Then "パスワードが更新される"
          .And "更新が完了した旨とログインページへのリンクが表示される"
      end

      When "パスワードが最低文字数に満たないか、確認用と一致しないと、" do
        Then "エラーメッセージが表示される"
          .And "パスワードは更新されない"
      end
    end

    Given "リンクが有効期限切れ・使用済み・不正なとき" do
      When "新しいパスワードを送信すると、" do
        Then "リンクが無効である旨のエラーメッセージが表示される"
          .And "パスワードは更新されない"
      end
    end

    Given "リンクにトークンが含まれていないとき" do
      When "再設定ページを開くと、" do
        Then "無効なリンクである旨と、再設定メールの送信ページへのリンクが表示される"
      end
    end
  end
end
