Feature "メールアドレス認証" do
  Scenario "確認メールのリンクからの認証" do
    Given "新規登録後に確認メールを受け取ったとき" do
      When "有効期限内に確認メールのリンクを開くと、" do
        Then "メールアドレスが認証される"
          .And "ログイン状態になる"
          .And "認証が完了した旨とホームへのボタンが表示される"
      end

      When "有効期限切れ・使用済み・不正なリンクを開くと、" do
        Then "認証に失敗した旨のエラーメッセージが表示される"
          .And "新規登録ページへ戻るボタンが表示される"
      end
    end

    Given "確認メールを複数回受け取ったとき" do
      When "有効期限内のいずれかのリンクを開くと、" do
        Then "メールアドレスが認証される"
      end
    end
  end

  Scenario "未認証ユーザーの操作制限" do
    # 閲覧やログインは認証前でも可能。書き込み系の操作は認証が必要
    Given "メールアドレスが未認証の状態でログインしているとき" do
      When "記事・講座の作成・編集ページにアクセスすると、" do
        Then "メールアドレスの認証が必要な旨と確認メールの再送ボタンが表示される"
      end

      When "いいね・コメント・フォロー・記事の削除・画像のアップロードをしようとすると、" do
        Then "メールアドレスの認証を促すモーダルが表示される"
          .And "操作は実行されない"
      end
    end
  end

  Scenario "確認メールの再送" do
    Given "メールアドレスが未認証の状態でログインしているとき" do
      When "確認メールの再送ボタンを押すと、" do
        Then "確認メールが再送される"
      end

      When "直前に確認メールを送信していると、" do
        Then "しばらく待ってから再度試すよう促すメッセージが表示される"
          .And "確認メールは送信されない"
      end
    end
  end

  Scenario "未認証アカウントの削除" do
    Given "新規登録後、一定期間メールアドレスが認証されなかったとき" do
      When None do
        # 期間の正は UnverifiedUserDeletionProcessor.Retention
        Then "そのアカウントは自動的に削除される"
      end
    end
  end
end
