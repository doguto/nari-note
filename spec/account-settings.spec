Feature "アカウント設定" do
  Scenario "アクセス制限" do
    Given "未ログイン状態のとき" do
      When "設定の各ページにアクセスすると、" do
        Then "ログインページにリダイレクトされる"
      end
    end
  end

  Scenario "設定メニュー" do
    Given "ログイン状態のとき" do
      When "設定の各ページにアクセスすると、" do
        Then "プロフィール編集、パスワード変更、退会のメニューが表示される"
      end
    end
  end

  Scenario "パスワード変更" do
    Given "パスワード変更ページを表示しているとき" do
      When "現在のパスワードと、新しいパスワード・確認用パスワードを入力して変更すると、" do
        Then "パスワードが変更される"
          .And "変更した旨のメッセージが表示され、入力欄が空になる"
      end

      When "現在のパスワードが誤っていると、" do
        Then "現在のパスワードが正しくない旨のエラーメッセージが表示される"
          .And "パスワードは変更されない"
      end

      When "未入力の項目がある、新しいパスワードが最低文字数に満たない、または確認用と一致しないと、" do
        Then "該当する入力欄にエラーメッセージが表示される"
          .And "パスワードは変更されない"
      end
    end
  end

  Scenario "退会" do
    Given "退会ページを表示しているとき" do
      When None do
        Then "退会すると記事・講座・コメント・いいね・フォロー・プロフィールが削除され、元に戻せない旨が表示される"
      end

      When "パスワードを入力して退会ボタンを押すと、" do
        Then "最終確認のダイアログが表示される"
      end

      When "確認ダイアログで退会を実行すると、" do
        Then "アカウントと関連データが削除される"
          .And "ログアウト状態でトップページに遷移する"
      end

      When "確認ダイアログでキャンセルすると、" do
        Then "ダイアログが閉じ、退会は実行されない"
      end

      When "誤ったパスワードで退会を実行すると、" do
        Then "パスワードが正しくない旨のエラーメッセージが表示される"
          .And "退会は実行されない"
      end

      When "パスワードを入力せずに退会ボタンを押すと、" do
        Then "入力を促すエラーメッセージが表示される"
      end
    end
  end
end
