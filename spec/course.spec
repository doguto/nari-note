Feature "講座" do
  # 講座は複数の記事をまとめたもの。講座に属する記事は単体記事の一覧・検索には出さず、講座として扱う
  Scenario "講座の作成" do
    Given "メールアドレス認証済みでログインしているとき" do
      When "講座作成ページで講座名を入力して保存すると、" do
        Then "講座が下書きとして作成される"
          .And "講座のページに遷移する"
      end

      When "講座名が空、または上限文字数を超えた状態で保存しようとすると、" do
        Then "エラーメッセージが表示される"
          .And "講座は作成されない"
      end
    end

    Given "未ログイン状態のとき" do
      When "講座作成・編集ページにアクセスすると、" do
        Then "ログインページにリダイレクトされる"
      end
    end

    Given "メールアドレスが未認証のとき" do
      When "講座作成・編集ページにアクセスすると、" do
        Then "メールアドレスの認証が必要な旨と確認メールの再送ボタンが表示される"
      end
    end
  end

  Scenario "講座の編集" do
    Given "自分の講座の編集ページを表示しているとき" do
      When None do
        Then "講座名が入力された状態で表示される"
          .And "下書きを含む講座内の記事一覧が表示される"
          .And "記事を追加するボタンが表示される"
      end

      When "記事を追加するボタンを押すと、" do
        Then "その講座に属する記事の作成ページに遷移する"
      end

      When "講座内の記事をクリックすると、" do
        Then "その記事の編集ページに遷移する"
      end

      When "講座名を変更して保存すると、" do
        Then "講座名が更新される"
          .And "講座のページに遷移する"
      end
    end

    Given "未保存の変更があるとき" do
      When "ページを離れようとすると、" do
        Then "ブラウザの離脱確認が表示される"
      end
    end
  end

  Scenario "講座の公開" do
    Given "自分の講座の編集ページを表示しているとき" do
      When "投稿設定から今すぐ公開すると、" do
        Then "講座が公開される"
          .And "講座内の下書き記事も合わせて公開される"
      end

      When "投稿設定から予約投稿で未来の日時を指定すると、" do
        Then "講座と講座内の下書き記事は指定日時まで作成者以外に公開されない"
      end
    end
  end

  Scenario "講座の閲覧" do
    Given "講座が公開されているとき" do
      When "講座ページにアクセスすると、" do
        Then "講座名、作成者、作成日、記事数、いいね数が表示される"
          .And "公開済みの記事が講座内の順序で番号付きで表示される"
          .And "X への共有ボタンが表示される"
      end

      When "講座内の記事をクリックすると、" do
        Then "その記事のページに遷移する"
          .And "記事ページに講座へのリンクが表示される"
      end

      When "作成者をクリックすると、" do
        Then "作成者のプロフィールページに遷移する"
      end
    end

    Given "講座が下書きまたは予約投稿で公開日時前のとき" do
      When "作成者本人がアクセスすると、" do
        Then "講座が表示される"
      end

      When "作成者以外がアクセスすると、" do
        Then "講座が見つからない旨が表示される"
      end
    end
  end

  Scenario "マイ講座一覧" do
    Given "未ログイン状態のとき" do
      When "マイ講座一覧ページにアクセスすると、" do
        Then "ログインページにリダイレクトされる"
      end
    end

    Given "ログイン状態のとき" do
      When "マイ講座一覧ページにアクセスすると、" do
        Then "「公開済み」と「下書き」のタブが件数付きで表示される"
          .And "新規講座作成ボタンが表示される"
          .And "自分の講座のみが表示される"
      end

      When "講座のメニューから編集を選ぶと、" do
        Then "その講座の編集ページに遷移する"
      end
    end
  end

  Scenario "講座の削除" do
    Given "マイ講座一覧に講座が表示されているとき" do
      When "講座のメニューから削除を選ぶと、" do
        Then "削除確認のモーダルが表示される"
      end

      When "削除確認のモーダルで削除を実行すると、" do
        Then "講座と講座内の記事が削除される"
          .And "一覧が更新される"
      end

      When "削除確認のモーダルでキャンセルすると、" do
        Then "モーダルが閉じる"
          .And "講座は削除されない"
      end
    end
  end
end
